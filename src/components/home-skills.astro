---
const skills = [
  "TypeScript",
  "Next.js",
  "Tailwind CSS",
  "Convex",
  "tRPC",
  "Prisma ORM",
  "PostgreSQL",
  "Python",
  "Docker",
];
---

<section class="mt-10">
  <h2 class="font-semibold text-base">Tech Stack</h2>
  <div class="mt-4 flex flex-wrap gap-2">
    {skills.map((skill) => (
        <span class="cursor-default rounded-full border bg-muted/50 px-3 py-1 text-sm transition-colors duration-150 hover:bg-muted">
          {skill}
        </span>
      ))}
  </div>
</section>
