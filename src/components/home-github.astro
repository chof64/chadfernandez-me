---
import { contributionCellClass } from "~/lib/contributions";

const username = "chof64";
const skeletonCells = 53 * 7;
---

<section data-github-card data-username={username}>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="font-semibold text-base">Recent Activity</h2>
    <p
      aria-live="polite"
      class="text-muted-foreground text-xs tabular-nums"
      data-github-total
    >
      Loading contributions…
    </p>
  </div>

  <div class="mt-5">
    <div
      aria-describedby="contribution-scroll-hint"
      aria-label="GitHub contribution activity for the last year"
      class="overflow-x-auto overscroll-x-contain rounded-sm [scrollbar-width:thin] focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-4"
      data-github-scroll
      role="region"
      tabindex="0"
    >
      <div class="w-max sm:w-full" data-github-canvas>
        <div
          aria-hidden="true"
          class="grid h-3 grid-cols-[repeat(var(--contribution-weeks,53),10px)] gap-[3px] text-[10px] text-muted-foreground leading-none sm:grid-cols-[repeat(var(--contribution-weeks,53),minmax(0,1fr))] sm:gap-0.5"
          data-github-months
        ></div>
        <div
          aria-busy="true"
          aria-label="GitHub contribution activity for the last year"
          class="mt-2 grid grid-flow-col grid-rows-[repeat(7,auto)] grid-cols-[repeat(var(--contribution-weeks,53),10px)] gap-[3px] motion-safe:animate-pulse sm:grid-cols-[repeat(var(--contribution-weeks,53),minmax(0,1fr))] sm:gap-0.5"
          data-github-grid
          role="img"
        >
          {Array.from({ length: skeletonCells }, () => (
              <div
                aria-hidden="true"
                class={contributionCellClass}
              />
            ))}
        </div>
      </div>
    </div>
    <p
      class="mt-3 text-muted-foreground text-xs sm:hidden"
      id="contribution-scroll-hint"
    >
      Swipe for earlier weeks
    </p>
    <noscript>
      <p class="mt-3 text-muted-foreground text-xs">
        Enable JavaScript to see contribution activity, or{" "}
        <a
          class="underline hover:text-foreground"
          href={`https://github.com/${username}`}
          rel="noopener noreferrer"
          target="_blank"
          >view it on GitHub</a
        >.
      </p>
    </noscript>
  </div>
</section>

<script>
  import {
    type Contribution,
    contributionCellClass,
    dateFromIso,
    getMonthLabels,
  } from "~/lib/contributions";

  const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
  const numberFormatter = new Intl.NumberFormat("en-US");
  const dateFormatter = new Intl.DateTimeFormat("en-US", {
    dateStyle: "medium",
    timeZone: "UTC",
  });

  const isContribution = (value: unknown): value is Contribution => {
    if (typeof value !== "object" || value === null) {
      return false;
    }

    const record = value as Record<string, unknown>;

    return (
      typeof record.date === "string" &&
      ISO_DATE.test(record.date) &&
      typeof record.count === "number" &&
      Number.isInteger(record.count) &&
      record.count >= 0 &&
      typeof record.level === "number" &&
      Number.isInteger(record.level) &&
      record.level >= 0 &&
      record.level <= 4
    );
  };

  const toWeeks = (contributions: Contribution[]) => {
    const first = contributions[0];

    if (!first) {
      throw new Error("Missing contribution data");
    }

    const leadingDays = dateFromIso(first.date).getUTCDay();
    const days: (Contribution | null)[] = [
      ...Array.from({ length: leadingDays }, () => null),
      ...contributions,
    ];
    const weeks: (Contribution | null)[][] = [];

    for (let index = 0; index < days.length; index += 7) {
      const week = days.slice(index, index + 7);

      while (week.length < 7) {
        week.push(null);
      }

      weeks.push(week);
    }

    return weeks;
  };

  const buildCells = (weeks: (Contribution | null)[][]) => {
    const cells: HTMLDivElement[] = [];

    for (const week of weeks) {
      for (const contribution of week) {
        const cell = document.createElement("div");
        cell.className = contributionCellClass;
        cell.setAttribute("aria-hidden", "true");

        if (contribution) {
          const unit =
            contribution.count === 1 ? "contribution" : "contributions";

          cell.dataset.level = String(contribution.level);
          cell.title = `${dateFormatter.format(dateFromIso(contribution.date))}: ${numberFormatter.format(contribution.count)} ${unit}`;
        } else {
          cell.classList.add("invisible");
        }

        cells.push(cell);
      }
    }

    return cells;
  };

  const renderMonths = (
    element: HTMLElement,
    weeks: (Contribution | null)[][]
  ) => {
    element.replaceChildren(
      ...getMonthLabels(weeks).map(({ label, start, end }) => {
        const month = document.createElement("span");
        month.className = "truncate";
        month.style.gridColumn = `${start + 1} / ${end + 1}`;
        month.textContent = label;
        return month;
      })
    );
  };

  const card = document.querySelector<HTMLElement>("[data-github-card]");

  if (card) {
    const username = card.dataset.username;
    const totalElement = card.querySelector<HTMLElement>("[data-github-total]");
    const monthsElement = card.querySelector<HTMLElement>(
      "[data-github-months]"
    );
    const gridElement = card.querySelector<HTMLElement>("[data-github-grid]");
    const scrollElement = card.querySelector<HTMLElement>(
      "[data-github-scroll]"
    );
    const hintElement = card.querySelector<HTMLElement>(
      "#contribution-scroll-hint"
    );

    if (
      username &&
      totalElement &&
      monthsElement &&
      gridElement &&
      scrollElement &&
      hintElement
    ) {
      const scrollToLatest = () => {
        scrollElement.scrollLeft = scrollElement.scrollWidth;
      };

      scrollToLatest();

      const load = async () => {
        const response = await fetch(
          `https://github-contributions-api.jogruber.de/v4/${username}?y=last`,
          { signal: AbortSignal.timeout(8000) }
        );

        if (!response.ok) {
          throw new Error("Contribution request failed");
        }

        const payload = (await response.json()) as {
          contributions?: unknown;
        };

        if (
          !Array.isArray(payload.contributions) ||
          payload.contributions.length === 0 ||
          !payload.contributions.every(isContribution)
        ) {
          throw new Error("Invalid contribution response");
        }

        const contributions = payload.contributions;
        const weeks = toWeeks(contributions);

        gridElement.replaceChildren(...buildCells(weeks));
        gridElement.classList.remove("motion-safe:animate-pulse");
        gridElement.removeAttribute("aria-busy");
        scrollElement.style.setProperty(
          "--contribution-weeks",
          String(weeks.length)
        );

        const total = contributions.reduce(
          (sum, contribution) => sum + contribution.count,
          0
        );
        const formattedTotal = numberFormatter.format(total);
        const unit = total === 1 ? "contribution" : "contributions";

        totalElement.textContent = `${formattedTotal} ${unit} last year`;
        gridElement.setAttribute(
          "aria-label",
          `GitHub contribution activity: ${formattedTotal} ${unit} in the last year`
        );

        renderMonths(monthsElement, weeks);
        scrollToLatest();
      };

      load().catch(() => {
        totalElement.textContent = "Contribution activity unavailable.";
        scrollElement.hidden = true;
        hintElement.hidden = true;
      });
    }
  }
</script>
