---
import { Image } from "astro:assets";
import heroPortrait from "~/assets/hero-portrait.jpeg";
import ContactLink from "~/components/contact-link.astro";
import HomeGitHub from "~/components/home-github.astro";
import HomeSkills from "~/components/home-skills.astro";
import Layout from "~/layouts/layout.astro";
---

<Layout>
  <div class="mx-auto my-16 max-w-2xl px-8">
    <section class="mt-24 text-center">
      <div class="animate-fade-up opacity-0">
        <Image
          alt="Portrait"
          class="mx-auto h-24 w-24 rounded-lg object-cover"
          fetchpriority="high"
          height={96}
          loading="eager"
          src={heroPortrait}
          width={96}
        />
      </div>

      <h1
        class="mt-6 animate-fade-up font-semibold text-2xl tracking-tight opacity-0 [animation-delay:60ms]"
      >
        Chad Fernandez
      </h1>

      <p
        class="mt-1 animate-fade-up font-medium text-muted-foreground text-sm opacity-0 [animation-delay:90ms]"
      >
        Software Engineer
      </p>

      <p
        class="mx-auto mt-4 animate-fade-up text-muted-foreground/80 leading-relaxed opacity-0 [animation-delay:120ms]"
      >
        Self-taught full-stack developer with a BS in Information Technology. I
        love exploring how technology works and building apps that help people.
        When I'm not coding, you'll find me competing in hackathons, working on
        startup, or joining webinars.
      </p>
    </section>

    <div class="mt-16">
      <HomeGitHub />

      <HomeSkills />

      <section class="mt-10">
        <h2 class="font-semibold text-base">Contact</h2>
        <p class="mt-2 text-muted-foreground/80 text-sm">
          I'm open to projects and collaborations. Let's connect.
        </p>
        <div class="mt-4 flex items-center gap-4">
          <ContactLink
            href="mailto:contact@chadfernandez.me"
            icon="email"
            label="email me"
          />
          <ContactLink
            external
            href="https://github.com/chof64"
            icon="github"
            label="GitHub"
          />
          <ContactLink
            external
            href="https://www.linkedin.com/in/chof64"
            icon="linkedin"
            label="LinkedIn"
          />
        </div>
      </section>
    </div>
  </div>
</Layout>
